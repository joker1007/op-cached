# op-cached user service.
#
# Install:
#   cp contrib/op-cached.service ~/.config/systemd/user/
#   systemctl --user enable --now op-cached
#
# When the daemon is managed by systemd, consider setting
# OP_CACHED_NO_SPAWN=1 in your shell so clients never auto-spawn a
# competing daemon (which would hold the socket and make this unit
# fail to start).

[Unit]
Description=op-cached daemon (GPG-encrypted cache for 1Password CLI)

[Service]
ExecStart=%h/.cargo/bin/op-cached daemon
Environment=OP_CACHED_TTL=7d
Restart=on-failure

[Install]
WantedBy=default.target
